<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container page-estreita">
    <h1>Editar evento</h1>
    <%- include('../partials/alertas') %>

    <form action="/eventos/<%= evento.id %>/editar" method="POST" class="form">
      <label for="titulo">Título</label>
      <input type="text" id="titulo" name="titulo" value="<%= evento.titulo %>" required>

      <label for="descricao">Descrição</label>
      <textarea id="descricao" name="descricao" rows="4" required><%= evento.descricao %></textarea>

      <div class="form-row">
        <div>
          <label for="data_evento">Data</label>
          <input type="date" id="data_evento" name="data_evento"
                 value="<%= new Date(evento.data_evento).toISOString().split('T')[0] %>" required>
        </div>
        <div>
          <label for="horario">Horário</label>
          <input type="time" id="horario" name="horario" value="<%= evento.horario %>" required>
        </div>
      </div>

      <label for="local">Local</label>
      <input type="text" id="local" name="local" value="<%= evento.local %>" required>

      <label for="capacidade">Capacidade máxima (opcional)</label>
      <input type="number" id="capacidade" name="capacidade" min="1" value="<%= evento.capacidade || '' %>">

      <button type="submit" class="btn btn-primary btn-full">Salvar alterações</button>
    </form>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
