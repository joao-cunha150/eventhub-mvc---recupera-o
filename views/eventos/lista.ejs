<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container page">
    <h1>Eventos disponíveis</h1>
    <%- include('../partials/alertas') %>

    <% if (eventos.length === 0) { %>
      <p class="empty-state">Nenhum evento disponível no momento.</p>
    <% } else { %>
      <div class="grid-cards">
        <% eventos.forEach(function(evento) { %>
          <a href="/eventos/<%= evento.id %>" class="card-evento">
            <h3><%= evento.titulo %></h3>
            <p class="evento-meta">
              📅 <%= new Date(evento.data_evento).toLocaleDateString('pt-BR') %> às <%= evento.horario %>
            </p>
            <p class="evento-meta">📍 <%= evento.local %></p>
            <p class="evento-organizador">Organizado por <%= evento.organizador_nome %></p>
            <p class="evento-inscritos">
              <%= evento.total_inscritos %><%= evento.capacidade ? ' / ' + evento.capacidade : '' %> inscritos
            </p>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
